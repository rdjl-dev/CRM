# Server
PORT=3001
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change-this-in-production
JWT_EXPIRES=8h

# Google Login
GOOGLE_CLIENT_ID=

# Email (Gmail SMTP)
SMTP_USER=
SMTP_PASS=

# Persistence
# Local default: backend/data/db.json
# On Render: use a mounted disk, for example /var/data/db.json
DB_FILE=
DATA_DIR=
